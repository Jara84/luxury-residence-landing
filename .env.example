# Copiar a .env.local para desarrollo. Para producción, crear cada variable en
# GitHub (Settings > Secrets and variables > Actions > Variables).
# Si alguna queda vacía, la página funciona igual: esa pieza simplemente no se activa.

# Google Analytics 4 — ID de medición (empieza por G-)
VITE_GA_ID=

# Píxel de Meta — ID numérico del píxel. Sin esto no hay retargeting en
# Instagram y Facebook, que es la mitad del rendimiento de la pauta.
VITE_META_PIXEL_ID=

# Endpoint del formulario de contacto (Formspree, Basin, Netlify Forms…).
# Vacío = no se muestra el formulario ni se pide correo para el brochure.
VITE_FORM_ENDPOINT=
